#!/bin/sh
# First-boot defaults for the BleachWrt-like x86_64 build.
# Runs once via /etc/uci-defaults; failures must never block boot.

# --- hostname / timezone (BleachWrt-like) ---
uci -q set system.@system[0].hostname='ImmortalWrt' 2>/dev/null
uci -q set system.@system[0].timezone='CST-8' 2>/dev/null
uci -q set system.@system[0].zonename='Asia/Shanghai' 2>/dev/null
uci -q commit system 2>/dev/null

# --- LuCI: Chinese UI + Argon theme ---
uci -q set luci.main.lang='zh_cn' 2>/dev/null
if [ -d /www/luci-static/argon ]; then
	uci -q set luci.main.mediaurlbase='/luci-static/argon' 2>/dev/null
fi
uci -q commit luci 2>/dev/null

# --- root password (default: password, same as BleachWrt) ---
if [ -f /etc/shadow ]; then
	sed -i 's|^root:[^:]*:|root:$6$z992pusoopewje8p$6Gue4Tm/23LA09Al/Lahpp8cpmQKJxx9SuuRDkwfX0iO4SqOeBIFHgw2UYmQhf4fYp9nB8YwGEzk.dkOv2xxh0:|' /etc/shadow 2>/dev/null
fi

# --- enable wireless radios if an mt7921e/mt7922 phy is present ---
if [ -x /sbin/wifi ]; then
	uci -q set wireless.radio0.disabled='0' 2>/dev/null
	uci -q set wireless.radio1.disabled='0' 2>/dev/null
	uci -q set wireless.radio2.disabled='0' 2>/dev/null
	uci -q commit wireless 2>/dev/null
fi

exit 0
